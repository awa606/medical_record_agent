 .panel-caution { color: var(--muted); font-size: 13px; white-space: nowrap; }
 .download-state { margin: 0 0 16px; padding: 12px 16px; border: 1px solid var(--panel-border); border-radius: 4px; background: var(--selected); }
+
+/* Projection layout. Keep working status visible on the visit list and note. */
+:root {
+  --canvas: #edf3f4;
+  --text: #183341;
+  --muted: #506975;
+  --primary: #076b6b;
+  --hover: #075655;
+  --selected: #e1f1ee;
+  --panel-border: #c6d8d9;
+  font-family: "Segoe UI", "Microsoft YaHei UI", "Microsoft YaHei", sans-serif;
+}
+.topbar { background: #12363f; color: #fff; border-bottom-color: #12363f; }
+.topbar .brand, .topbar .nav-item, .topbar .text-button { color: #e8f5f1; }
+.topbar .brand img { background: #fff; border-radius: 5px; }
+.topbar .nav-item.active, .topbar .nav-item:hover, .topbar .text-button:hover { color: #fff; background: #20505a; border-bottom-color: #73d4bd; }
+.queue-page .page-header { padding: 22px 24px; border-radius: 10px; background: #184851; color: white; }
+.queue-page .title-line h1 { font-size: 30px; line-height: 1.35; }
+.queue-page .page-header .muted { color: #daeeeb; }
+.encounter-table thead th { background: #e4ecec; color: #365661; font-size: 14px; }
+.encounter-table td { font-size: 16px; }
+.encounter-table tbody tr:hover { background: #f5faf9; }
+.queue-status { display: inline-block; border-radius: 20px; padding: 2px 10px; font-size: 14px; white-space: nowrap; background: #e8eff4; color: #334f63; }
+.queue-status[data-state="active"] { background: #d7efe6; color: #164f46; }
+.queue-status[data-state="completed"] { background: #ebeeee; color: #46595b; }
+.record-header { box-shadow: inset 4px 0 #16786f; }
+.panel-header { background: #eef5f4; }
+@media (max-width: 700px) {
+  .queue-page .page-header { padding: 14px; }
+  .queue-page .title-line h1 { font-size: 24px; }
+}
